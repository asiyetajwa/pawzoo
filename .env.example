# Copy to .env (same folder) and fill in. .env is git-ignored, and its values win over the same names in your system.
# Everything here is optional: without a key, Pawzoo answers with rules and templates.

# NVIDIA Nemotron on Nebius Token Factory (https://tokenfactory.nebius.com).
# NEBIUS_API_KEY=
# The spending cap for model calls, in USD. Calls past it are refused before they are sent. Required with a key.
# PAWZOO_BUDGET_USD=0.15
# Override the models (Token Factory ids):
# PAWZOO_TOOLS_MODEL=nvidia/nemotron-3-super-120b-a12b
# PAWZOO_PHRASE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# The evening digest: the time on Pawzoo's clock, and the token the standalone job must send.
# PAWZOO_DIGEST_AT=19:00
# PAWZOO_JOB_TOKEN=

# ElevenLabs voice for spoken answers (your key from elevenlabs.io, with the Text to Speech permission).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
